    gripperYawFlip: 0
  - note: push at 130 deg
    pushAngleDeg: 130
    pushLength: 0.1
    startBranchSeedDeg: []
    cartesianTransfer: 0
    matchedPairId: 
    branchLabel: 
    gripperYawFlip: 0
  - note: push toward the robot (-Z)
    pushAngleDeg: 180
    pushLength: 0.1
    startBranchSeedDeg: []
    cartesianTransfer: 0
    matchedPairId: 
    branchLabel: 
    gripperYawFlip: 0
